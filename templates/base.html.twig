<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <title>{% block title %}Parfum d'Orient{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text><text y=%221.3em%22 x=%220.2em%22 font-size=%2276%22 fill=%22%23fff%22>sf</text></svg>">
        
        {% block stylesheets %}
            <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
            <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
            <link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet">
            <link href="{{ asset('css/style.css') }}" rel="stylesheet">
            <style>
                .navbar-nav .nav-link {
                    padding-left: 0.5rem !important;
                    padding-right: 0.5rem !important;
                    font-size: 0.9rem;
                }
                body {
                    background-image: url('/img/fond2.jpeg') !important;
                    background-size: cover !important;
                    background-attachment: fixed !important;
                    background-position: center !important;
                    background-color: transparent !important;
                }
                .container {
                    background: transparent !important;
                }
            </style>
        {% endblock %}
    </head>
    
    <body>

        {# Curseur personnalisé #}
        <div id="custom-cursor" style="
            width: 20px;
            height: 20px;
            border: 1px solid rgba(212,165,116,0.6);
            border-radius: 50%;
            position: fixed;
            pointer-events: none;
            z-index: 9999;
            transform: translate(-50%, -50%);
            transition: all 0.1s ease;
            mix-blend-mode: difference;
        "></div>

        {# Navbar #}
        <nav class="navbar navbar-expand-lg navbar-dark" style="
            background: rgba(62, 39, 35, 0.45) !important;
            backdrop-filter: blur(15px);
            -webkit-backdrop-filter: blur(15px);
            border-bottom: 1px solid rgba(212, 165, 116, 0.3);
            box-shadow: 0 4px 30px rgba(0, 0, 0, 0.2);
        ">
            <div class="container">
                <a class="navbar-brand fw-bold d-flex align-items-center" href="/">
                    <img src="{{ asset('img/logobedouin.jpg') }}" 
                         alt="Parfum d'Orient" 
                         style="height: 50px; width: 50px; object-fit: cover; border-radius: 50%; margin-right: 12px;
                                box-shadow: 0 0 15px rgba(212,165,116,0.5);
                                border: 2px solid rgba(212,165,116,0.4);">
                    Parfum d'Orient
                </a>
                
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                    <span class="navbar-toggler-icon"></span>
                </button>
                
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav ms-auto">

                        {% if app.user and 'ROLE_ADMIN' in app.user.roles %}
                            <li class="nav-item">
                                <a class="nav-link" href="{{ path('app_dashboard') }}">📊 Admin</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="{{ path('app_category_index') }}">Catégories</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="{{ path('app_product_index') }}">Produits</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="{{ path('app_user_index') }}">Membres</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="{{ path('app_order_index') }}">Commandes</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="{{ path('app_message_index') }}">Messages SAV</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="{{ path('app_newsletter_index') }}">Newsletter</a>
                            </li>
                        {% endif %}

                        {% if not (app.user and 'ROLE_ADMIN' in app.user.roles) %}
                            <li class="nav-item">
                                <a class="nav-link position-relative" href="{{ path('app_cart') }}">
                                    🛒 Panier
                                    {% set cartCount = app.request.session.get('cart', [])|length %}
                                    {% if cartCount > 0 %}
                                        <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
                                            {{ cartCount }}
                                        </span>
                                    {% endif %}
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="{{ path('app_contact') }}">📧 Contact</a>
                            </li>
                            {% if app.user %}
                                <li class="nav-item">
                                    <a class="nav-link" href="{{ path('app_my_orders') }}">📦 Mes commandes</a>
                                </li>
                            {% endif %}
                        {% endif %}

                        {% if app.user %}
                            <li class="nav-item">
                                <span class="nav-link">
                                    <i class="fa-solid fa-circle-user"></i> {{ app.user.nom }}
                                </span>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="{{ path('app_logout') }}">🚪 Déconnexion</a>
                            </li>
                        {% else %}
                            <li class="nav-item">
                                <a class="nav-link" href="{{ path('app_register') }}">📝 Inscription</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="{{ path('app_login') }}">🔐 Connexion</a>
                            </li>
                        {% endif %}

                    </ul>
                </div>
            </div>
        </nav>

        {# Contenu principal #}
        <div class="container my-4">

            {% for message in app.flashes('success') %}
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    {{ message }}
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            {% endfor %}
            
            {% for message in app.flashes('error') %}
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    {{ message }}
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            {% endfor %}
            
            {% block body %}{% endblock %}

        </div>

        {# Footer #}
        <footer class="mt-5 py-5" style="
            background: rgba(62, 39, 35, 0.45) !important;
            backdrop-filter: blur(15px);
            -webkit-backdrop-filter: blur(15px);
            border-top: 1px solid rgba(212, 165, 116, 0.3);
            box-shadow: 0 -4px 30px rgba(0, 0, 0, 0.2);
            color: white;
        ">
            <div class="container">
                <div class="row">
                    <div class="col-md-4 mb-4">
                        <h5 class="fw-bold mb-3" style="color: #d4a574; letter-spacing: 2px;">🐪 Parfum d'Orient</h5>
                        <p style="color: rgba(255,255,255,0.8); line-height: 1.8;">
                            Découvrez nos parfums authentiques venus du Moyen-Orient
                        </p>
                        <div class="mt-3">
                            <span style="display: inline-block; width: 40px; height: 2px; background: linear-gradient(90deg, #d4a574, transparent);"></span>
                        </div>
                    </div>
                    <div class="col-md-4 mb-4">
                        <h5 class="fw-bold mb-3" style="color: #d4a574; letter-spacing: 2px;">Liens rapides</h5>
                        <ul class="list-unstyled">
                            <li class="mb-2"><a href="{{ path('app_home') }}" class="text-decoration-none" style="color: rgba(255,255,255,0.8); transition: all 0.3s;" onmouseover="this.style.color='#d4a574'; this.style.paddingLeft='8px'" onmouseout="this.style.color='rgba(255,255,255,0.8)'; this.style.paddingLeft='0'">→ Accueil</a></li>
                            <li class="mb-2"><a href="{{ path('app_contact') }}" class="text-decoration-none" style="color: rgba(255,255,255,0.8); transition: all 0.3s;" onmouseover="this.style.color='#d4a574'; this.style.paddingLeft='8px'" onmouseout="this.style.color='rgba(255,255,255,0.8)'; this.style.paddingLeft='0'">→ Contact</a></li>
                            <li class="mb-2"><a href="{{ path('app_legal') }}" class="text-decoration-none" style="color: rgba(255,255,255,0.8); transition: all 0.3s;" onmouseover="this.style.color='#d4a574'; this.style.paddingLeft='8px'" onmouseout="this.style.color='rgba(255,255,255,0.8)'; this.style.paddingLeft='0'">→ Mentions Légales</a></li>
                            <li class="mb-2"><a href="{{ path('app_cgv') }}" class="text-decoration-none" style="color: rgba(255,255,255,0.8); transition: all 0.3s;" onmouseover="this.style.color='#d4a574'; this.style.paddingLeft='8px'" onmouseout="this.style.color='rgba(255,255,255,0.8)'; this.style.paddingLeft='0'">→ CGV</a></li>
                            <li class="mb-2"><a href="{{ path('app_cgu') }}" class="text-decoration-none" style="color: rgba(255,255,255,0.8); transition: all 0.3s;" onmouseover="this.style.color='#d4a574'; this.style.paddingLeft='8px'" onmouseout="this.style.color='rgba(255,255,255,0.8)'; this.style.paddingLeft='0'">→ CGU</a></li>
                        </ul>
                    </div>
                    <div class="col-md-4 mb-4">
                        <h5 class="fw-bold mb-3" style="color: #d4a574; letter-spacing: 2px;">Contact</h5>
                        <p class="mb-2" style="color: rgba(255,255,255,0.8);">📧 contact@parfumdorient.fr</p>
                        <p class="mb-2" style="color: rgba(255,255,255,0.8);">📞 06 59 45 46 47</p>
                        <p class="mb-0" style="color: rgba(255,255,255,0.8);">📍 1 Place Mendes France, 91200 Athis Mons</p>
                    </div>
                </div>
                <hr style="border-color: rgba(212, 165, 116, 0.3);">
                <div class="text-center">
                    <p class="mb-0" style="color: rgba(255,255,255,0.6); font-size: 0.9rem;">
                        &copy; 2025 Parfum d'Orient — Tous droits réservés
                    </p>
                </div>
            </div>
        </footer>

        {# Scripts #}
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
        <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js"></script>
        <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/ScrollTrigger.min.js"></script>
        <script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
        <script>
            AOS.init({ duration: 800, easing: 'ease-in-out', once: true, offset: 80 });
        </script>
        <script>
            // Navbar effet scroll
            window.addEventListener('scroll', () => {
                const navbar = document.querySelector('.navbar');
                if (window.scrollY > 50) {
                    navbar.classList.add('scrolled');
                } else {
                    navbar.classList.remove('scrolled');
                }
            });

            // Curseur personnalisé
            document.addEventListener('mousemove', (e) => {
                const cursor = document.getElementById('custom-cursor');
                if (cursor) {
                    cursor.style.left = e.clientX + 'px';
                    cursor.style.top = e.clientY + 'px';
                }
            });
        </script>

        {% block body_javascripts %}{% endblock %}

    </body>
</html>